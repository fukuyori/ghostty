// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#include "ghostty-version.h"

// winver.h constants. Keep the resource build independent of an installed
// Windows SDK because Zig supplies its own resource compiler.
#define GHOSTTY_VS_FFI_FILEFLAGSMASK 0x0000003fL
#define GHOSTTY_VS_FF_DEBUG          0x00000001L
#define GHOSTTY_VOS_NT_WINDOWS32     0x00040004L
#define GHOSTTY_VFT_APP              0x00000001L
#define GHOSTTY_VFT2_UNKNOWN         0x00000000L
#define GHOSTTY_VERSION_INFO         1

#define RT_MANIFEST 1
RT_MANIFEST 24 "ghostty.manifest"

#define ID_ICON_GHOSTTY 1
ID_ICON_GHOSTTY ICON "ghostty.ico"

#define IDOK 1
#define IDCANCEL 2
#define IDD_TAB_TITLE 102
#define IDC_TAB_TITLE 1001

IDD_TAB_TITLE DIALOGEX 0, 0, 260, 82
STYLE 0x80C800C0
CAPTION "Change Tab Title"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Leave blank to restore the default.", -1, 8, 8, 244, 10
    EDITTEXT        IDC_TAB_TITLE, 8, 24, 244, 14, 0x0080
    DEFPUSHBUTTON   "OK", IDOK, 142, 58, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 58, 52, 14
END

// Modeless per-pane search bar: WS_CHILD | WS_CLIPCHILDREN | DS_CONTROL |
// DS_SETFONT. Native edit/button controls provide keyboard and IME support.
104 DIALOGEX 0, 0, 360, 24
STYLE 0x42000440
// WS_EX_LAYERED gives GDI controls their own redirection bitmap under the
// D3D11 parent's WS_EX_NOREDIRECTIONBITMAP composition surface.
EXSTYLE 0x00080000
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Find:", 1100, 4, 7, 22, 10
    EDITTEXT        1101, 28, 4, 180, 16, 0x0080
    LTEXT           "", 1102, 212, 7, 56, 10
    PUSHBUTTON      "Previous", 1103, 272, 4, 34, 16
    DEFPUSHBUTTON   "Next", IDOK, 310, 4, 24, 16
    PUSHBUTTON      "Close", IDCANCEL, 338, 4, 24, 16
END

// Command palette. The native edit handles IME composition; the list is
// refreshed from the configured commands and live terminal destinations.
106 DIALOGEX 0, 0, 380, 212
STYLE 0x80C800C0
CAPTION "Command Palette"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        1201, 8, 8, 364, 18, 0x0080
    LISTBOX         1202, 8, 32, 364, 148, 0x50A10001
    LTEXT           "", 1203, 8, 185, 364, 14
    DEFPUSHBUTTON   "Run", IDOK, 260, 198, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 320, 198, 52, 14
END

GHOSTTY_VERSION_INFO VERSIONINFO
FILEVERSION     GHOSTTY_VERSION_MAJOR,GHOSTTY_VERSION_MINOR,GHOSTTY_VERSION_PATCH,GHOSTTY_VERSION_BUILD
PRODUCTVERSION  GHOSTTY_VERSION_MAJOR,GHOSTTY_VERSION_MINOR,GHOSTTY_VERSION_PATCH,GHOSTTY_VERSION_BUILD
FILEFLAGSMASK   GHOSTTY_VS_FFI_FILEFLAGSMASK
#if GHOSTTY_VERSION_DEBUG
FILEFLAGS       GHOSTTY_VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          GHOSTTY_VOS_NT_WINDOWS32
FILETYPE        GHOSTTY_VFT_APP
FILESUBTYPE     GHOSTTY_VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        VALUE "FileDescription",  "Ghostty terminal emulator"
        VALUE "FileVersion",      GHOSTTY_VERSION_STRING
        VALUE "OriginalFilename", "ghostty.exe"
        VALUE "ProductName",      "Ghostty"
        VALUE "ProductVersion",   GHOSTTY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
